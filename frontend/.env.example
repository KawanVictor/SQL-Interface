# Endereço do backend usado pelo proxy do Vite (npm run dev / npm run preview)
BACKEND_URL=http://localhost:8000

# Opcional: URL pública da API quando o frontend é servido sem o proxy do Vite.
# Nesse caso a origem do frontend precisa estar em ALLOWED_ORIGINS no backend.
# VITE_API_URL=https://api.exemplo.com
